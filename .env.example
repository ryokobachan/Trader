# Unicorn server-side configuration.
# The internal Provider APIs read these selections server-side. `mock` is the
# redistributable default; `yahoo`, `benzinga`, and `fmp` are opt-in real-data adapters.
# Copy to .env.local for local development and never commit real credentials.

# Runtime
UNICORN_ENV=development
UNICORN_LOG_LEVEL=info
UNICORN_PUBLIC_BASE_URL=http://localhost:3001

# Installed/default provider selection. The UI may choose only from adapters
# enabled by the deployment; it never receives the API keys below.
UNICORN_INSTRUMENT_PROVIDER=mock
UNICORN_MARKET_PROVIDER=mock
# Chart bars can use a different adapter from quote/snapshot data.
UNICORN_BARS_PROVIDER=
UNICORN_PROFILE_PROVIDER=
UNICORN_FUNDAMENTALS_PROVIDER=
UNICORN_EARNINGS_PROVIDER=
UNICORN_ANALYST_PROVIDER=
UNICORN_NEWS_PROVIDER=
UNICORN_LOGO_PROVIDER=local

# Yahoo compatibility adapter: local/personal use only. Both values are
# required when instrument, market, fundamentals, or news selects Yahoo.
UNICORN_USAGE_MODE=personal
UNICORN_ENABLE_YAHOO_COMPAT=false
UNICORN_YAHOO_TIMEOUT_MS=4000

# Optional local chart sidecar. `npm run dev:yahoo` and `npm run dev:midas`
# start it automatically and generate an ephemeral token. Set these manually
# only when the application and sidecar are launched separately.
UNICORN_TRADINGVIEW_SIDECAR_URL=http://127.0.0.1:8791
UNICORN_TRADINGVIEW_SIDECAR_TOKEN=
UNICORN_TRADINGVIEW_SIDECAR_TIMEOUT_MS=25000
# Unicorn's chart defaults to 1,000 candles and lets the user choose 2–10,000.
# Operators may lower the hard ceiling here; other API clients can still omit
# count and use the adapter default.
UNICORN_TRADINGVIEW_MAX_CANDLES=10000
UNICORN_TRADINGVIEW_FETCH_TIMEOUT_SECONDS=20
# The same authenticated sidecar also batches watchlist reference closes from
# TradingView `{EXCHANGE}:{TICKER}USDT.P`; it requires no additional API key.
# Candidates are tried in order. Add another TradingView exchange code here to
# customize resolution without changing the provider or UI implementation.
UNICORN_TRADINGVIEW_SYNTHETIC_EXCHANGES=BINANCE,BITGET,KUCOIN,MEXC

# Set true only after the deployment has an applicable data-display licence.
UNICORN_ALLOW_RESTRICTED_PUBLIC_DISPLAY=false

# Example keyless local real-data profile. Benzinga follows Midas' calendar
# ratings request contract and accepts an optional token when one is available.
# UNICORN_INSTRUMENT_PROVIDER=yahoo
# UNICORN_MARKET_PROVIDER=yahoo
# UNICORN_BARS_PROVIDER=tradingview-websocket
# UNICORN_PROFILE_PROVIDER=fmp
# UNICORN_FUNDAMENTALS_PROVIDER=yahoo
# UNICORN_EARNINGS_PROVIDER=fmp
# UNICORN_ANALYST_PROVIDER=benzinga
# UNICORN_NEWS_PROVIDER=yahoo
# UNICORN_ENABLE_YAHOO_COMPAT=true

# Provider credentials (server-side only; never use NEXT_PUBLIC_ prefixes)
MASSIVE_API_KEY=
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_TIMEOUT_SECONDS=12

# Optional Benzinga settings. TOKEN takes precedence over the legacy KEY alias.
# The default endpoint and request shape match Midas' analyst-ratings adapter.
BENZINGA_API_TOKEN=
BENZINGA_API_KEY=
BENZINGA_TIMEOUT_SECONDS=20
BENZINGA_ANALYST_RATINGS_ENDPOINT=https://www.benzinga.com/api-next/calendar/ratings
BENZINGA_ANALYST_RATINGS_DISABLED=false

# SEC data.sec.gov needs no API key, but automated clients must identify
# themselves. Replace this value with a real app name and contact address.
SEC_EDGAR_USER_AGENT=Unicorn/0.1 contact@example.com
SEC_EDGAR_MAX_REQUESTS_PER_SECOND=8

# Credential policy. "env" is the single-user/self-hosted default.
# A multi-user deployment must use an encrypted secret-store adapter and save
# only credential references in the application database.
PROVIDER_CREDENTIAL_MODE=env
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=

# Transactional application data: users, workspaces, watchlists, strategies,
# portfolios, presets, and job metadata. Do not store OHLCV blobs here.
APP_DATABASE_URL=sqlite:///./var/app/unicorn.sqlite

# Searchable U.S. instrument master. It is deliberately separate from the
# transactional application database and from chart time-series storage.
CATALOG_DATABASE_URL=sqlite:///./var/catalog/instruments.sqlite
INSTRUMENT_SYNC_SCHEDULE=0 5 * * *

# Immutable/analytical stores. Production values may be s3://, r2://, or
# another adapter-supported URI.
MARKET_DATA_URI=./var/market
FUNDAMENTALS_DATA_URI=./var/fundamentals
BACKTEST_ARTIFACTS_URI=./var/artifacts/backtests
PROVIDER_RAW_DATA_URI=./var/artifacts/providers

# Cache/queue. Optional in single-process local mode.
CACHE_URL=redis://localhost:6379/0
JOB_QUEUE_URL=redis://localhost:6379/1
