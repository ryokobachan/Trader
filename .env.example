# Trader server-side configuration.
#
# `api/config.json` is the non-secret default. Leave provider selections
# blank to use that file. Values set here (or by a dev profile) override JSON.
# Copy this file to `.env.local`; never commit real credentials.

# Optional deployment overrides. Supported IDs are documented next to the
# JSON in `api/README.md` and validated by `npm run config:check`.
TRADER_INSTRUMENT_PROVIDER=
TRADER_MARKET_PROVIDER=
TRADER_BARS_PROVIDER=
TRADER_PROFILE_PROVIDER=
TRADER_FUNDAMENTALS_PROVIDER=
TRADER_EARNINGS_PROVIDER=
TRADER_RESEARCH_PROVIDER=
TRADER_ANALYST_PROVIDER=
TRADER_NEWS_PROVIDER=

# Legacy Ideas only. Investment datasets and their catalog do not use Midas.
TRADER_MIDAS_API_BASE_URL=http://127.0.0.1:8787

# Root containing finance/13f and finance/x. Read directly, never copied.
# Default for source development is the sibling develop/.data directory.
# Set this in the helper process environment for a packaged desktop build.
TRADER_SHARED_DATA_ROOT=

# Standalone research sources: SEC, FINRA, USAspending, FRED, CNN.
# SEC requests require your real organization/application and contact email.
SEC_EDGAR_USER_AGENT=
# Free FRED API key. Stored server-side; never use a NEXT_PUBLIC_ prefix.
FRED_API_KEY=

# Example TradingView financials plus Google Finance/Yahoo research role map. `npm run dev:midas` applies this
# profile and starts the TradingView quote/chart sidecar for you.
# TRADER_INSTRUMENT_PROVIDER=yahoo
# TRADER_MARKET_PROVIDER=tradingview-websocket
# TRADER_BARS_PROVIDER=tradingview-websocket
# TRADER_PROFILE_PROVIDER=yahoo
# TRADER_FUNDAMENTALS_PROVIDER=tradingview
# TRADER_EARNINGS_PROVIDER=tradingview
# TRADER_RESEARCH_PROVIDER=yahoo
# TRADER_ANALYST_PROVIDER=google-finance-benzinga
# TRADER_NEWS_PROVIDER=yahoo

# Yahoo compatibility adapter: local/personal use only. Both values are
# required when a selected role uses Yahoo.
TRADER_USAGE_MODE=personal
TRADER_ENABLE_YAHOO_COMPAT=false
TRADER_YAHOO_TIMEOUT_MS=4000

# TradingView websocket sidecar for direct USD quotes and chart bars. The local
# launchers generate an ephemeral token automatically. For a hosted Sites app,
# use an externally reachable HTTPS URL and a server-side token; loopback points
# to the hosted runtime itself and cannot reach a developer machine. Never put
# this token in browser code or a public URL.
TRADER_TRADINGVIEW_SIDECAR_URL=http://127.0.0.1:8791
TRADER_TRADINGVIEW_SIDECAR_TOKEN=
TRADER_TRADINGVIEW_SIDECAR_TIMEOUT_MS=25000
TRADER_TRADINGVIEW_MAX_CANDLES=10000
TRADER_TRADINGVIEW_FETCH_TIMEOUT_SECONDS=20
TRADER_TRADINGVIEW_SYNTHETIC_EXCHANGES=BINANCE,BITGET,KUCOIN,MEXC
# Launcher-only controls.
TRADER_TRADINGVIEW_SIDECAR_PORT=8791
TRADER_TRADINGVIEW_PYTHON=python3

# Set true only after the deployment has an applicable data-display licence.
TRADER_ALLOW_RESTRICTED_PUBLIC_DISPLAY=false

# TradingView scanner needs no API key. Full FY/FQ statements and dated earnings
# use the authenticated Trader sidecar above; TA-Lib calculations use it too.
TRADER_TRADINGVIEW_FUNDAMENTALS_TIMEOUT_MS=12000
TRADER_TRADINGVIEW_FUNDAMENTALS_CACHE_TTL_SECONDS=3600

# Benzinga-compatible analyst ratings. TOKEN takes precedence over KEY.
BENZINGA_API_TOKEN=
BENZINGA_API_KEY=
BENZINGA_TIMEOUT_SECONDS=20
BENZINGA_ANALYST_RATINGS_ENDPOINT=https://www.benzinga.com/api-next/calendar/ratings
BENZINGA_ANALYST_RATINGS_DISABLED=false

# Google Finance analyst ratings parsed server-side from the Analysis page's
# AF_initDataCallback data argument. No Google credential is required.
# The real-data launchers above select the composite by default.
GOOGLE_FINANCE_TIMEOUT_SECONDS=20
GOOGLE_FINANCE_CACHE_TTL_SECONDS=3600
GOOGLE_FINANCE_MAX_HTML_BYTES=5000000
# Optional earnings-specific overrides; otherwise the shared settings above apply.
GOOGLE_FINANCE_EARNINGS_TIMEOUT_SECONDS=12
GOOGLE_FINANCE_EARNINGS_CACHE_TTL_SECONDS=3600

# Optional standalone TipRanks Enterprise analyst ratings (server-side only).
TIPRANKS_API_KEY=
TIPRANKS_API_TOKEN=
TIPRANKS_BASE_URL=https://api.tipranks.com/api
TIPRANKS_TIMEOUT_SECONDS=20
# TipRanks data is aggregated daily; keep a transient cache to protect quotas.
TIPRANKS_CACHE_TTL_SECONDS=3600
TIPRANKS_ANALYST_RATINGS_LIMIT=100
