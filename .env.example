# Unicorn server-side configuration.
#
# `api/config.json` is the non-secret default. Leave provider selections
# blank to use that file. Values set here (or by a dev profile) override JSON.
# Copy this file to `.env.local`; never commit real credentials.

# Optional deployment overrides. Supported IDs are documented next to the
# JSON in `api/README.md` and validated by `npm run config:check`.
UNICORN_INSTRUMENT_PROVIDER=
UNICORN_MARKET_PROVIDER=
UNICORN_BARS_PROVIDER=
UNICORN_PROFILE_PROVIDER=
UNICORN_FUNDAMENTALS_PROVIDER=
UNICORN_EARNINGS_PROVIDER=
UNICORN_ANALYST_PROVIDER=
UNICORN_NEWS_PROVIDER=

# Example FMP/Benzinga real-data role map. `npm run dev:midas` applies this
# profile and starts the TradingView quote/chart sidecar for you.
# UNICORN_INSTRUMENT_PROVIDER=yahoo
# UNICORN_MARKET_PROVIDER=tradingview-websocket
# UNICORN_BARS_PROVIDER=tradingview-websocket
# UNICORN_PROFILE_PROVIDER=fmp
# UNICORN_FUNDAMENTALS_PROVIDER=fmp
# UNICORN_EARNINGS_PROVIDER=fmp
# UNICORN_ANALYST_PROVIDER=benzinga
# UNICORN_NEWS_PROVIDER=yahoo

# Yahoo compatibility adapter: local/personal use only. Both values are
# required when a selected role uses Yahoo.
UNICORN_USAGE_MODE=personal
UNICORN_ENABLE_YAHOO_COMPAT=false
UNICORN_YAHOO_TIMEOUT_MS=4000

# TradingView websocket sidecar for direct USD quotes and chart bars. The local
# launchers generate an ephemeral token automatically. For a hosted Sites app,
# use an externally reachable HTTPS URL and a server-side token; loopback points
# to the hosted runtime itself and cannot reach a developer machine. Never put
# this token in browser code or a public URL.
UNICORN_TRADINGVIEW_SIDECAR_URL=http://127.0.0.1:8791
UNICORN_TRADINGVIEW_SIDECAR_TOKEN=
UNICORN_TRADINGVIEW_SIDECAR_TIMEOUT_MS=25000
UNICORN_TRADINGVIEW_MAX_CANDLES=10000
UNICORN_TRADINGVIEW_FETCH_TIMEOUT_SECONDS=20
UNICORN_TRADINGVIEW_SYNTHETIC_EXCHANGES=BINANCE,BITGET,KUCOIN,MEXC
# Launcher-only controls.
UNICORN_TRADINGVIEW_SIDECAR_PORT=8791
UNICORN_TRADINGVIEW_PYTHON=python3

# Set true only after the deployment has an applicable data-display licence.
UNICORN_ALLOW_RESTRICTED_PUBLIC_DISPLAY=false

# Financial Modeling Prep (server-side only).
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_TIMEOUT_SECONDS=12

# Benzinga-compatible analyst ratings. TOKEN takes precedence over KEY.
BENZINGA_API_TOKEN=
BENZINGA_API_KEY=
BENZINGA_TIMEOUT_SECONDS=20
BENZINGA_ANALYST_RATINGS_ENDPOINT=https://www.benzinga.com/api-next/calendar/ratings
BENZINGA_ANALYST_RATINGS_DISABLED=false
