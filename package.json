{
  "name": "trader-stock-analysis",
  "version": "0.1.0",
  "description": "A customizable open-source workspace for U.S. stock charts, research, watchlists, indicators, and sample strategies.",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryokobachan/Trader.git"
  },
  "bugs": {
    "url": "https://github.com/ryokobachan/Trader/issues"
  },
  "homepage": "https://github.com/ryokobachan/Trader#readme",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:midas": "node src/tooling/scripts/dev-with-tradingview.mjs --profile=midas",
    "dev:yahoo": "node src/tooling/scripts/dev-with-tradingview.mjs --profile=yahoo",
    "dev:tradingview": "node src/tooling/scripts/dev-with-tradingview.mjs",
    "dev:midas:app": "node src/tooling/scripts/dev-with-midas-env.mjs",
    "dev:yahoo:app": "node src/tooling/scripts/dev-with-yahoo.mjs",
    "sidecar:tradingview": "python3 api/tradingview-websocket/sidecar.py",
    "desktop:prepare": "node src/desktop/prepare.mjs",
    "desktop:dev": "npm run desktop:prepare && cd src/desktop/tauri && ../../../node_modules/.bin/tauri dev --no-dev-server --no-watch",
    "desktop:build": "node src/desktop/build.mjs",
    "config:check": "node --env-file-if-exists=.env.local --import tsx src/tooling/scripts/check-trader-config.ts",
    "strategy": "tsx src/tooling/scripts/strategy-cli.ts",
    "build": "npm run config:check && vinext build",
    "start": "vinext start",
    "test": "npm run build && npm run test:contracts && node --test tests/rendered-html.test.mjs",
    "test:contracts": "tsx --test tests/*-registry.test.ts tests/*-provider.test.ts tests/dev-with-midas-env.test.mjs tests/dev-with-yahoo.test.mjs tests/dev-with-tradingview.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "0.45.2",
    "lightweight-charts": "^5.2.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.0",
    "react-server-dom-webpack": "^19.2.8",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.1",
    "wrangler": "^4.120.0"
  },
  "type": "module"
}
